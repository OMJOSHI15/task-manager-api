# Copy this file to .env and fill in your own values. .env is gitignored.

# Local MongoDB (default if you have `mongod` running on your machine):
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager

# Or a free MongoDB Atlas cluster instead — get the connection string from
# Atlas > Database > Connect > Drivers, then swap in your username/password:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager?retryWrites=true&w=majority

# On macOS, port 5000 is often already taken by Control Center's AirPlay
# Receiver — if curl/the browser can't reach the server or you see a
# confusing "Access denied / 403" page, that's AirPlay eating the port,
# not your app. Either pick a different port here (e.g. 5050) or disable
# AirPlay Receiver in System Settings > General > AirDrop & Handoff.
PORT=5000
